# Replace all paths for the client host. Address and private key files must be 0600.
TAILCAT_BIN=/opt/homebrew/bin/tailcat
TAILCAT_KEY_FILE=/absolute/private/path/client-default.private.json
TAILCAT_ADDR_FILE=/absolute/private/path/tailcat-server-address
TAILCAT_RELAY_PORT=8787
TAILCAT_LOCAL_PORT=18787
RELAY_CA_FILE=/absolute/private/path/relay-ca.pem
RELAY_TOKEN_FILE=/absolute/private/path/relay-token
SIDECAR_DATA_DIR=/absolute/private/path/node-data
SIDECAR_PORT=8802
