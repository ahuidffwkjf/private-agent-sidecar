# Copy outside the repository. Values are absolute paths; never place secrets here.
TAILCAT_RELAY_PORT=8787
RELAY_DATABASE=/var/lib/agent-relay/relay.db
RELAY_TLS_CERT=/etc/agent-sidecar/tls/relay-fullchain.pem
RELAY_TLS_KEY=/etc/agent-sidecar/tls/relay-privkey.pem
RELAY_TOKEN_FILE=/etc/agent-sidecar/relay-token
RELAY_RATE_LIMIT=120
