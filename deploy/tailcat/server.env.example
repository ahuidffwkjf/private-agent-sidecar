# Replace the placeholder with public client nodekeys. Never use an empty allowlist.
TAILCAT_BIN=/usr/local/bin/tailcat
TAILCAT_KEY_FILE=/var/lib/tailcat-relay/config/tailcat/keys/sidecar-relay.private.json
TAILCAT_CLIENT_KEYS=nodekey:REPLACE_WITH_64_HEX_CLIENT_PUBLIC_KEY
TAILCAT_ADDR_FILE=/var/lib/tailcat-relay/tailcat-server-address
TAILCAT_RELAY_PORT=8787
